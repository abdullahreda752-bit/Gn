# ---- Server ----
PORT=3000
# Only these website origins may call the chatbot from a browser:
ALLOWED_ORIGIN=http://localhost:8000,http://127.0.0.1:8000

# ---- Choose ONE AI provider ----
# groq | openai | gemini | anthropic | ollama | openai-compatible
AI_PROVIDER=gemini

# Put the key of the provider you chose (never in public/ files, never in chat, never on GitHub):
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=AQ.Ab8RN6IiVamyj3C1o25qcmogsObrF93BCNiN29nd68TR_7s7tA
ANTHROPIC_API_KEY=

# Optional: override the default model name (check your provider's current model list)
# Defaults: groq=llama-3.3-70b-versatile  openai=gpt-4o-mini  gemini=gemini-2.0-flash  anthropic=claude-haiku-5-5  ollama=qwen3:4b
AI_MODEL=

# Only for AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Only for AI_PROVIDER=openai-compatible (any OpenAI-style API)
AI_BASE_URL=
AI_API_KEY=
